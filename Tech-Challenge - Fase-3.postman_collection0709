          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Keycloak respondeu com sucesso', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.access_token, 'access_token').to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('patientToken', body.access_token);",
                  "    const expiresAt = Date.now() + (Number(body.expires_in || 0) * 1000);",
                  "    pm.collectionVariables.set('patientTokenExpiresAt', String(expiresAt));",
                  "    console.log('patientToken atualizado automaticamente');",
                  "}"
                ]
              }
            }
